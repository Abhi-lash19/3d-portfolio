# EmailJS credentials used by the Contact form (src/components/Contact.jsx).
# Copy this file to .env and fill in the values from https://dashboard.emailjs.com
# All three are required for the contact form to send mail.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=
